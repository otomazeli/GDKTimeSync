<Window x:Class="GDK.TimeSync.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GDK TimeSync Settings" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Connections" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0" Foreground="DimGray" Text="Credentials are stored in Windows Credential Manager, never in settings.json." TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Jira base URL" />
            <TextBox x:Name="JiraBaseUrlTextBox" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="4">
            <TextBlock Text="Toggl API token" />
            <PasswordBox x:Name="TogglTokenPasswordBox" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="6">
            <TextBlock Text="Jira personal access token" />
            <PasswordBox x:Name="JiraTokenPasswordBox" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,10,0" IsCancel="True">Cancel</Button>
            <Button Width="90" IsDefault="True" Click="OnSaveClick">Save</Button>
        </StackPanel>
    </Grid>
</Window>
