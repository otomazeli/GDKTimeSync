<Window x:Class="GDK.TimeSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GDK TimeSync" Height="420" Width="760" MinHeight="420" MinWidth="700"
        Closing="OnClosing">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="GDK TimeSync" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0" Text="Toggl → Jira → Tempo" Foreground="DimGray" FontSize="15" />
        </StackPanel>
        <Border Grid.Row="2" Padding="22" Background="#FFF7F7F7" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Connection status" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Margin="0,16,0,0" FontSize="15" TextWrapping="Wrap" />
                <Separator Margin="0,22,0,18" />
                <TextBlock Text="Sync and reconciliation will become available once the client orchestration layer is configured." TextWrapping="Wrap" Foreground="DimGray" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Margin="0,0,10,0" Click="OnSettingsClick">Settings</Button>
            <Button Width="100" IsEnabled="False">Sync Now</Button>
        </StackPanel>
    </Grid>
</Window>