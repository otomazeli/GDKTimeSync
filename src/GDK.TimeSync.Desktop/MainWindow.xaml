<Window x:Class="GDK.TimeSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:GDK.TimeSync.Desktop.ViewModels"
        xmlns:views="clr-namespace:GDK.TimeSync.Desktop.Views"
        Title="GDK TimeSync" Height="650" Width="1080" MinHeight="560" MinWidth="900"
        Closing="OnClosing" Loaded="OnLoaded">
    <Window.Resources>
        <DataTemplate x:Key="TodayTemplate"><views:TodayView /></DataTemplate>
        <DataTemplate x:Key="TemplatesTemplate"><views:TemplatesView /></DataTemplate>
        <DataTemplate x:Key="HistoryTemplate"><views:HistoryView /></DataTemplate>
        <DataTemplate x:Key="SettingsTemplate"><views:SettingsView /></DataTemplate>
        <DataTemplate x:Key="ReviewTemplate"><views:ReviewView /></DataTemplate>
        <DataTemplate x:Key="DiagnosticsTemplate"><views:DiagnosticsView /></DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#FF1F2937" Padding="16">
            <StackPanel>
                <TextBlock Text="GDK TimeSync" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,24" Text="Toggl → Jira → Tempo" Foreground="#FFD1D5DB" />
                <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static viewModels:NavigationPage.Today}">Today</Button>
                <Button Margin="0,8,0,0" Command="{Binding NavigateCommand}" CommandParameter="{x:Static viewModels:NavigationPage.Templates}">Templates</Button>
                <Button Margin="0,8,0,0" Command="{Binding NavigateCommand}" CommandParameter="{x:Static viewModels:NavigationPage.History}">History</Button>
                <Button Margin="0,8,0,0" Command="{Binding NavigateCommand}" CommandParameter="{x:Static viewModels:NavigationPage.Settings}">Settings</Button>
                <Button Margin="0,8,0,0" Command="{Binding NavigateCommand}" CommandParameter="{x:Static viewModels:NavigationPage.Review}">End-of-day review</Button>
                <Button Margin="0,8,0,0" Command="{Binding NavigateCommand}" CommandParameter="{x:Static viewModels:NavigationPage.Diagnostics}">Diagnostics</Button>
                <TextBlock Margin="0,28,0,8" Text="Connections" Foreground="#FFD1D5DB" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding ConnectionStatus.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Ellipse Width="10" Height="10" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse"><Setter Property="Fill" Value="#FF9CA3AF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Connected"><Setter Property="Fill" Value="#FF22C55E" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Fill" Value="#FFEF4444" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Name}" Foreground="White" Width="54" />
                                <TextBlock Text="{Binding Message}" Foreground="#FFD1D5DB" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Margin="0,10,0,0" Command="{Binding ConnectionStatus.RefreshCommand}" Content="Refresh connections" />
                <TextBlock Margin="0,18,0,0" Text="Last sync" Foreground="#FFD1D5DB" FontWeight="SemiBold" />
                <TextBlock Margin="0,3,0,0" Text="{Binding Main.SyncStatusText, TargetNullValue='Not synced yet'}" Foreground="#FFD1D5DB" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock Text="Workspace" FontSize="28" FontWeight="SemiBold" />
            <Border Grid.Row="2" Padding="22" Background="#FFF7F7F7" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="6">
                <ContentControl Content="{Binding CurrentPageViewModel}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Static viewModels:NavigationPage.Today}"><Setter Property="ContentTemplate" Value="{StaticResource TodayTemplate}" /></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Static viewModels:NavigationPage.Templates}"><Setter Property="ContentTemplate" Value="{StaticResource TemplatesTemplate}" /></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Static viewModels:NavigationPage.History}"><Setter Property="ContentTemplate" Value="{StaticResource HistoryTemplate}" /></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Static viewModels:NavigationPage.Settings}"><Setter Property="ContentTemplate" Value="{StaticResource SettingsTemplate}" /></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Static viewModels:NavigationPage.Review}"><Setter Property="ContentTemplate" Value="{StaticResource ReviewTemplate}" /></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Static viewModels:NavigationPage.Diagnostics}"><Setter Property="ContentTemplate" Value="{StaticResource DiagnosticsTemplate}" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</Window>
