<UserControl x:Class="GDK.TimeSync.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="History" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Margin="0,8,0,0" Text="{Binding LoadError}" Foreground="Firebrick" TextWrapping="Wrap" />
        <TextBlock Margin="0,8,0,0" Text="No delivery history yet." Foreground="DimGray">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" Width="90" />
                            <TextBlock Text="{Binding TaskText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="90,2,0,0">
                            <TextBlock Text="{Binding StatusText}" />
                            <TextBlock Text=" — " Foreground="DimGray" />
                            <TextBlock Text="{Binding DestinationText}" Foreground="DimGray" />
                        </StackPanel>
                        <TextBlock Margin="90,0,0,0" Text="{Binding FailureText}" Foreground="Firebrick" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
